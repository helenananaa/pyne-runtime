//@version=6
strategy("Pyne pyramiding order slots confirmation 20261001", overlay=true, initial_capital=1000000000, pyramiding=2, process_orders_on_close=true, calc_on_order_fills=false, margin_long=0, margin_short=0, commission_value=0, slippage=0)
if bar_index == 0
    strategy.entry("A", strategy.long, qty=1)
if bar_index == 1
    strategy.order("B", strategy.long, qty=2)
if bar_index == 2
    strategy.entry("C", strategy.long, qty=1)
if bar_index == 3
    strategy.entry("D", strategy.long, qty=1)
if bar_index == 4
    strategy.close("A")
if bar_index == 5
    strategy.entry("E", strategy.long, qty=1)
if bar_index == 6
    strategy.close("B")
if bar_index == 7
    strategy.entry("F", strategy.long, qty=1)
if bar_index == 8
    strategy.close_all()
if bar_index == 9
    strategy.order("G", strategy.long, qty=1)
if bar_index == 10
    strategy.entry("H", strategy.long, qty=1)
if bar_index == 11
    strategy.order("I", strategy.long, qty=1)
if bar_index == 12
    strategy.entry("J", strategy.long, qty=1)
if bar_index == 13
    strategy.close_all()
held(string id) =>
    float quantity = 0
    if strategy.opentrades > 0
        for j = 0 to strategy.opentrades-1
            if strategy.opentrades.entry_id(j) == id
                quantity += strategy.opentrades.size(j)
    quantity
f(float v) => str.tostring(v,"#.##########")
var string rows = ""
if bar_index < 32
    rows += "PYNE_PYRAMIDING_CONFIRM|"+str.tostring(bar_index)+"|"+f(time)+"|"+f(open)+"|"+f(high)+"|"+f(low)+"|"+f(close)+"|"+f(volume)+"|"+f(strategy.position_size)+"|"+f(strategy.opentrades)+"|"+f(strategy.closedtrades)+"|"+f(strategy.position_avg_price)+"|"+f(strategy.netprofit)+"|"+f(held("A"))+"|"+f(held("B"))+"|"+f(held("C"))+"|"+f(held("D"))+"|"+f(held("E"))+"|"+f(held("F"))+"|"+f(held("G"))+"|"+f(held("H"))+"|"+f(held("I"))+"|"+f(held("J"))+";"
    if bar_index % 8 == 7
        log.info(rows)
        rows := ""
plot(strategy.position_size,"Position")
