//@version=6
indicator("Pyne masked history context 20261002", precision=10)
legacy_wpr(h, l, c, length) =>
    hh = ta.highest(h, length)
    ll = ta.lowest(l, length)
    range_ = hh - ll
    range_ != 0 ? -100 * (hh - c) / range_ : 0
input_value(values, index) =>
    index >= 0 and index < array.size(values) ? array.get(values, index) : na
int i = bar_index
var core_close_values = array.from(73257.8, 73766.3, 73731.3, 73497.6, 73319.5, 73106.6, 72776.1, 72875.7, 72855.2, 72725.9)
