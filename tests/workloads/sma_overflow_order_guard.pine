//@version=6
indicator("Pyne overflow order guard round48", precision=10)
int i = bar_index
float large = 160000000.0 * math.pow(10., 300)
float src_half = 80000000.0 * math.pow(10., 300)
float Native2_half = ta.sma(src_half, 2)
float Native3_half = ta.sma(src_half, 3)
float Sum2_half = math.sum(src_half, 2)
float Sum3_half = math.sum(src_half, 3)
float src_negativeHalf = -80000000.0 * math.pow(10., 300)
