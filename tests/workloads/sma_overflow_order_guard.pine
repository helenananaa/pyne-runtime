float Native3_negativeHalf = ta.sma(src_negativeHalf, 3)
float Sum2_negativeHalf = math.sum(src_negativeHalf, 2)
float Sum3_negativeHalf = math.sum(src_negativeHalf, 3)
float src_rotation = i % 3 == 1 ? -large : large
float Native2_rotation = ta.sma(src_rotation, 2)
float Native3_rotation = ta.sma(src_rotation, 3)
float Sum2_rotation = math.sum(src_rotation, 2)
float Sum3_rotation = math.sum(src_rotation, 3)
