//@version=6
indicator("Pyne array missing sort 20261002",overlay=false)
f(float v) => str.tostring(v,"#.##########")
getf(array<float> a,int k) => k < array.size(a) ? array.get(a,k) : float(na)
geti(array<int> a,int k) => k < array.size(a) ? float(array.get(a,k)) : float(na)
var string rows = ""
if bar_index < 16
    int c = bar_index % 8
    array<float> a = switch c
        0 => array.from(3.0,1.0,2.0,1.0,3.0)
        1 => array.from(3.0,float(na),1.0,float(na),2.0)
        2 => array.from(float(na),3.0,1.0,2.0,4.0)
        3 => array.from(3.0,1.0,2.0,4.0,float(na))
        4 => array.from(float(na),float(na),float(na),float(na),float(na))
        5 => array.new_float(0)
        6 => array.from(-2.0)
        7 => array.from(float(na),-2.0,0.0,-2.0,float(na))
        => array.new_float(0)
    array<float> up = array.copy(a)
    array<float> down = array.copy(a)
    array.sort(up,order.ascending)
    array.sort(down,order.descending)
    array<int> ui = array.sort_indices(a,order.ascending)
    array<int> di = array.sort_indices(a,order.descending)
    rows += "PYNE_ARRAY_MISSING|"+str.tostring(bar_index)+"|"+f(c)+"|"+f(array.size(a))+"|"+f(array.sum(a))+"|"+f(array.avg(a))+"|"+f(array.min(a))+"|"+f(array.max(a))
    rows += "|"+f(getf(a,0))
    rows += "|"+f(getf(a,1))
    rows += "|"+f(getf(a,2))
    rows += "|"+f(getf(a,3))
    rows += "|"+f(getf(a,4))
    rows += "|"+f(getf(up,0))
    rows += "|"+f(getf(up,1))
    rows += "|"+f(getf(up,2))
    rows += "|"+f(getf(up,3))
    rows += "|"+f(getf(up,4))
    rows += "|"+f(getf(down,0))
    rows += "|"+f(getf(down,1))
    rows += "|"+f(getf(down,2))
    rows += "|"+f(getf(down,3))
    rows += "|"+f(getf(down,4))
    rows += "|"+f(geti(ui,0))
    rows += "|"+f(geti(ui,1))
    rows += "|"+f(geti(ui,2))
    rows += "|"+f(geti(ui,3))
    rows += "|"+f(geti(ui,4))
    rows += "|"+f(geti(di,0))
    rows += "|"+f(geti(di,1))
    rows += "|"+f(geti(di,2))
    rows += "|"+f(geti(di,3))
    rows += "|"+f(geti(di,4))
    rows += "|1|1|1|1;"
    if bar_index % 8 == 7
        log.info(rows)
        rows := ""
plot(float(na),"Native array probe")
