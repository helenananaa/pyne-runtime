//@version=6
indicator("PYNE legacy DMI discriminator 55",overlay=false)
fmt(float x) => na(x) ? "NA" : str.tostring(x,"0.00000000000000000")
dmi(h,l,c,p,ap,fallback) =>
    up=ta.change(h)
    down=-ta.change(l)
    plus_dm=na(up) ? na : up > down and up > 0 ? up : 0
    minus_dm=na(down) ? na : down > up and down > 0 ? down : 0
    strict_tr=math.max(h-l,math.max(math.abs(h-c[1]),math.abs(l-c[1])))
    tr=fallback and na(c[1]) ? h-l : strict_tr
    trur=ta.rma(tr,p)
    plus=fixnan(100*ta.rma(plus_dm,p)/trur)
    minus=fixnan(100*ta.rma(minus_dm,p)/trur)
    total=plus+minus
    adx=100*ta.rma(math.abs(plus-minus)/(total==0?1:total),ap)
    [plus,minus,adx]
int i=bar_index
var advanced_high_codes=array.from(72583.7, 72288.0, 71884.9, 71662.6, 71600.0, 71788.5, 71670.7, 71645.2, 71670.0, 71419.8, 71439.5, 71564.0, float(na), float(na), float(na), float(na), float(na), float(na), float(na), float(na), float(na), float(na), float(na), float(na))
advanced_high=array.get(advanced_high_codes,i%24)
var advanced_low_codes=array.from(71862.6, 71350.0, 71387.6, 71035.3, 70650.9, 71438.9, 71350.1, 71358.0, 71383.8, 70911.0, 70806.0, 71199.0, float(na), float(na), float(na), float(na), float(na), float(na), float(na), float(na), float(na), float(na), float(na), float(na))
advanced_low=array.get(advanced_low_codes,i%24)
var advanced_close_codes=array.from(72193.1, 71698.7, 71548.5, 71099.4, 71537.7, 71617.9, 71470.1, 71571.0, 71419.8, 71004.6, 71376.6, 71391.5, float(na), float(na), float(na), float(na), float(na), float(na), float(na), float(na), float(na), float(na), float(na), float(na))
advanced_close=array.get(advanced_close_codes,i%24)
[oldp_advanced,oldm_advanced,olda_advanced]=dmi(advanced_high,advanced_low,advanced_close,3,3,true)
[newp_advanced,newm_advanced,newa_advanced]=dmi(advanced_high,advanced_low,advanced_close,3,3,false)
var trend_high_codes=array.from(73177.8, 72907.8, 73084.0, 72878.1, 72742.0, 72583.7, 72288.0, 71884.9, 71662.6, 71600.0, 71788.5, 71670.7, 71645.2, 71670.0, 71419.8, 71439.5, 71564.0, 71397.0, 71357.2, 70855.9, 71022.4, 71022.7, 70820.8, 70414.9)
trend_high=array.get(trend_high_codes,i%24)
var trend_low_codes=array.from(72668.0, 72573.5, 72801.1, 72551.0, 72188.0, 71862.6, 71350.0, 71387.6, 71035.3, 70650.9, 71438.9, 71350.1, 71358.0, 71383.8, 70911.0, 70806.0, 71199.0, 71071.5, 70555.7, 70038.0, 70768.5, 70690.1, 70222.2, 69889.1)
trend_low=array.get(trend_low_codes,i%24)
var trend_close_codes=array.from(72776.1, 72875.7, 72855.2, 72725.9, 72452.8, 72193.1, 71698.7, 71548.5, 71099.4, 71537.7, 71617.9, 71470.1, 71571.0, 71419.8, 71004.6, 71376.6, 71391.5, 71266.6, 70615.2, 70820.0, 70920.7, 70782.3, 70235.1, 70076.7)
trend_close=array.get(trend_close_codes,i%24)
[oldp_trend,oldm_trend,olda_trend]=dmi(trend_high,trend_low,trend_close,4,3,true)
[newp_trend,newm_trend,newa_trend]=dmi(trend_high,trend_low,trend_close,4,3,false)
var tuple_high_codes=array.from(72878.1, 72742.0, 72583.7, 72288.0, 71884.9, 71662.6, 71600.0, 71788.5, 71670.7, 71645.2, 71670.0, 71419.8, 71439.5, 71564.0, 71397.0, 71357.2, 70855.9, 71022.4, 71022.7, 70820.8, 70414.9, 70249.6, 70146.2, 69820.4)
tuple_high=array.get(tuple_high_codes,i%24)
var tuple_low_codes=array.from(72551.0, 72188.0, 71862.6, 71350.0, 71387.6, 71035.3, 70650.9, 71438.9, 71350.1, 71358.0, 71383.8, 70911.0, 70806.0, 71199.0, 71071.5, 70555.7, 70038.0, 70768.5, 70690.1, 70222.2, 69889.1, 69666.8, 69677.6, 69277.8)
tuple_low=array.get(tuple_low_codes,i%24)
var tuple_close_codes=array.from(72725.9, 72452.8, 72193.1, 71698.7, 71548.5, 71099.4, 71537.7, 71617.9, 71470.1, 71571.0, 71419.8, 71004.6, 71376.6, 71391.5, 71266.6, 70615.2, 70820.0, 70920.7, 70782.3, 70235.1, 70076.7, 70079.4, 69794.4, 69393.2)
tuple_close=array.get(tuple_close_codes,i%24)
[oldp_tuple,oldm_tuple,olda_tuple]=dmi(tuple_high,tuple_low,tuple_close,5,4,true)
[newp_tuple,newm_tuple,newa_tuple]=dmi(tuple_high,tuple_low,tuple_close,5,4,false)
if i<24 and barstate.isconfirmed
    row="PYNE_LEGACY_DMI_DISCRIMINATOR55|"+str.tostring(i)
    row+="|"+fmt(advanced_high)
    row+="|"+fmt(advanced_low)
    row+="|"+fmt(advanced_close)
    row+="|"+fmt(oldp_advanced)
    row+="|"+fmt(oldm_advanced)
    row+="|"+fmt(olda_advanced)
    row+="|"+fmt(newp_advanced)
    row+="|"+fmt(newm_advanced)
    row+="|"+fmt(newa_advanced)
    row+="|"+fmt(trend_high)
    row+="|"+fmt(trend_low)
    row+="|"+fmt(trend_close)
    row+="|"+fmt(oldp_trend)
    row+="|"+fmt(oldm_trend)
    row+="|"+fmt(olda_trend)
    row+="|"+fmt(newp_trend)
    row+="|"+fmt(newm_trend)
    row+="|"+fmt(newa_trend)
    row+="|"+fmt(tuple_high)
    row+="|"+fmt(tuple_low)
    row+="|"+fmt(tuple_close)
    row+="|"+fmt(oldp_tuple)
    row+="|"+fmt(oldm_tuple)
    row+="|"+fmt(olda_tuple)
    row+="|"+fmt(newp_tuple)
    row+="|"+fmt(newm_tuple)
    row+="|"+fmt(newa_tuple)
    log.info(row)
plot(newa_tuple)
