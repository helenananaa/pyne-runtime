//@version=6
indicator("Pyne percentile insertion matrix oracle 20260930",precision=10,max_bars_back=20)
int i=bar_index
float holes=i==7 or i==12 or i==19 ? na : float((i*7)%13-4)
float leading=i<5 ? na : float((i*7)%13-4)
float ties=i==6 or i==10 or i==11 or i==20 ? na : float(int(i/2)%3)
float alternating=i%5==1 or i%5==2 ? na : (i%2==0 ? -5.0 : 5.0)
float multiple=i<4 or i%6==0 or i%6==1 ? na : float((i*7)%13-4)
float empty=float(na)
f_window(float value,int p)=>
    var array<float> ordered=array.new_float()
    var array<int> ids=array.new_int()
    int expired=array.indexof(ids,bar_index-p)
    if expired>=0
        array.remove(ordered,expired)
        array.remove(ids,expired)
    int at=array.size(ordered)
    if at>0 and not na(value)
        for j=0 to at-1
            if value<array.get(ordered,j)
                at:=j
                break
    array.insert(ordered,at,value)
    array.insert(ids,at,bar_index)
    ordered
f_linear(array<float> ordered,int p,float pct)=>
    float out=na
    if bar_index>=p-1
        float position=math.max(0.0,math.min(p-1.0,pct/100.0*p-0.5))
        int lower=int(math.floor(position))
        int upper=math.min(lower+1,p-1)
        float a=array.get(ordered,lower)
        float b=array.get(ordered,upper)
        out:=a+(b-a)*(position-lower)
    out
