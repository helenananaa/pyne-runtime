//@version=6
indicator("Pyne overflow mask holdout round50", precision=10)
int i = bar_index
float half = 80000000.0 * math.pow(10., 300)
float large = 160000000.0 * math.pow(10., 300)
float ulp = math.pow(2., 970)
float edge = math.pow(2., 1023) - ulp
float small = float((i * 11) % 17 - 6) * 0.25
series float src_keywordHalf = half
float SMA1_keywordHalf = ta.sma(src_keywordHalf, 1)
int Missing_SMA1_keywordHalf = na(SMA1_keywordHalf) ? 1 : 0
float SUM1_keywordHalf = math.sum(src_keywordHalf, 1)
int Missing_SUM1_keywordHalf = na(SUM1_keywordHalf) ? 1 : 0
float SMA2_keywordHalf = ta.sma(src_keywordHalf, 2)
int Missing_SMA2_keywordHalf = na(SMA2_keywordHalf) ? 1 : 0
float SUM2_keywordHalf = math.sum(src_keywordHalf, 2)
int Missing_SUM2_keywordHalf = na(SUM2_keywordHalf) ? 1 : 0
float SMA3_keywordHalf = ta.sma(src_keywordHalf, 3)
int Missing_SMA3_keywordHalf = na(SMA3_keywordHalf) ? 1 : 0
float SUM3_keywordHalf = math.sum(src_keywordHalf, 3)
int Missing_SUM3_keywordHalf = na(SUM3_keywordHalf) ? 1 : 0
float SMA7_keywordHalf = ta.sma(src_keywordHalf, 7)
int Missing_SMA7_keywordHalf = na(SMA7_keywordHalf) ? 1 : 0
float SUM7_keywordHalf = math.sum(src_keywordHalf, 7)
int Missing_SUM7_keywordHalf = na(SUM7_keywordHalf) ? 1 : 0
series float src_branchHalf = i >= 0 ? half : 0.
float SMA1_branchHalf = ta.sma(src_branchHalf, 1)
int Missing_SMA1_branchHalf = na(SMA1_branchHalf) ? 1 : 0
float SUM1_branchHalf = math.sum(src_branchHalf, 1)
int Missing_SUM1_branchHalf = na(SUM1_branchHalf) ? 1 : 0
float SMA2_branchHalf = ta.sma(src_branchHalf, 2)
int Missing_SMA2_branchHalf = na(SMA2_branchHalf) ? 1 : 0
float SUM2_branchHalf = math.sum(src_branchHalf, 2)
int Missing_SUM2_branchHalf = na(SUM2_branchHalf) ? 1 : 0
float SMA3_branchHalf = ta.sma(src_branchHalf, 3)
int Missing_SMA3_branchHalf = na(SMA3_branchHalf) ? 1 : 0
float SUM3_branchHalf = math.sum(src_branchHalf, 3)
int Missing_SUM3_branchHalf = na(SUM3_branchHalf) ? 1 : 0
float SMA7_branchHalf = ta.sma(src_branchHalf, 7)
int Missing_SMA7_branchHalf = na(SMA7_branchHalf) ? 1 : 0
float SUM7_branchHalf = math.sum(src_branchHalf, 7)
int Missing_SUM7_branchHalf = na(SUM7_branchHalf) ? 1 : 0
series float src_edgeFinite = edge - float(i % 3) * ulp
float SMA1_edgeFinite = ta.sma(src_edgeFinite, 1)
int Missing_SMA1_edgeFinite = na(SMA1_edgeFinite) ? 1 : 0
float SUM1_edgeFinite = math.sum(src_edgeFinite, 1)
int Missing_SUM1_edgeFinite = na(SUM1_edgeFinite) ? 1 : 0
float SMA2_edgeFinite = ta.sma(src_edgeFinite, 2)
int Missing_SMA2_edgeFinite = na(SMA2_edgeFinite) ? 1 : 0
float SUM2_edgeFinite = math.sum(src_edgeFinite, 2)
int Missing_SUM2_edgeFinite = na(SUM2_edgeFinite) ? 1 : 0
float SMA3_edgeFinite = ta.sma(src_edgeFinite, 3)
int Missing_SMA3_edgeFinite = na(SMA3_edgeFinite) ? 1 : 0
float SUM3_edgeFinite = math.sum(src_edgeFinite, 3)
int Missing_SUM3_edgeFinite = na(SUM3_edgeFinite) ? 1 : 0
float SMA7_edgeFinite = ta.sma(src_edgeFinite, 7)
int Missing_SMA7_edgeFinite = na(SMA7_edgeFinite) ? 1 : 0
float SUM7_edgeFinite = math.sum(src_edgeFinite, 7)
int Missing_SUM7_edgeFinite = na(SUM7_edgeFinite) ? 1 : 0
series float src_edgeCancellation = i % 4 < 2 ? edge : -edge
float SMA1_edgeCancellation = ta.sma(src_edgeCancellation, 1)
int Missing_SMA1_edgeCancellation = na(SMA1_edgeCancellation) ? 1 : 0
float SUM1_edgeCancellation = math.sum(src_edgeCancellation, 1)
int Missing_SUM1_edgeCancellation = na(SUM1_edgeCancellation) ? 1 : 0
float SMA2_edgeCancellation = ta.sma(src_edgeCancellation, 2)
int Missing_SMA2_edgeCancellation = na(SMA2_edgeCancellation) ? 1 : 0
float SUM2_edgeCancellation = math.sum(src_edgeCancellation, 2)
int Missing_SUM2_edgeCancellation = na(SUM2_edgeCancellation) ? 1 : 0
float SMA3_edgeCancellation = ta.sma(src_edgeCancellation, 3)
int Missing_SMA3_edgeCancellation = na(SMA3_edgeCancellation) ? 1 : 0
float SUM3_edgeCancellation = math.sum(src_edgeCancellation, 3)
int Missing_SUM3_edgeCancellation = na(SUM3_edgeCancellation) ? 1 : 0
float SMA7_edgeCancellation = ta.sma(src_edgeCancellation, 7)
int Missing_SMA7_edgeCancellation = na(SMA7_edgeCancellation) ? 1 : 0
float SUM7_edgeCancellation = math.sum(src_edgeCancellation, 7)
int Missing_SUM7_edgeCancellation = na(SUM7_edgeCancellation) ? 1 : 0
series float src_preReadyRecover = i < 2 ? large : i < 4 ? -large : small
float SMA1_preReadyRecover = ta.sma(src_preReadyRecover, 1)
int Missing_SMA1_preReadyRecover = na(SMA1_preReadyRecover) ? 1 : 0
float SUM1_preReadyRecover = math.sum(src_preReadyRecover, 1)
int Missing_SUM1_preReadyRecover = na(SUM1_preReadyRecover) ? 1 : 0
float SMA2_preReadyRecover = ta.sma(src_preReadyRecover, 2)
int Missing_SMA2_preReadyRecover = na(SMA2_preReadyRecover) ? 1 : 0
float SUM2_preReadyRecover = math.sum(src_preReadyRecover, 2)
int Missing_SUM2_preReadyRecover = na(SUM2_preReadyRecover) ? 1 : 0
float SMA3_preReadyRecover = ta.sma(src_preReadyRecover, 3)
int Missing_SMA3_preReadyRecover = na(SMA3_preReadyRecover) ? 1 : 0
float SUM3_preReadyRecover = math.sum(src_preReadyRecover, 3)
int Missing_SUM3_preReadyRecover = na(SUM3_preReadyRecover) ? 1 : 0
float SMA7_preReadyRecover = ta.sma(src_preReadyRecover, 7)
int Missing_SMA7_preReadyRecover = na(SMA7_preReadyRecover) ? 1 : 0
float SUM7_preReadyRecover = math.sum(src_preReadyRecover, 7)
int Missing_SUM7_preReadyRecover = na(SUM7_preReadyRecover) ? 1 : 0
series float src_rotation = i % 3 == 1 ? -large : large
float SMA1_rotation = ta.sma(src_rotation, 1)
int Missing_SMA1_rotation = na(SMA1_rotation) ? 1 : 0
float SUM1_rotation = math.sum(src_rotation, 1)
int Missing_SUM1_rotation = na(SUM1_rotation) ? 1 : 0
float SMA2_rotation = ta.sma(src_rotation, 2)
int Missing_SMA2_rotation = na(SMA2_rotation) ? 1 : 0
float SUM2_rotation = math.sum(src_rotation, 2)
int Missing_SUM2_rotation = na(SUM2_rotation) ? 1 : 0
float SMA3_rotation = ta.sma(src_rotation, 3)
int Missing_SMA3_rotation = na(SMA3_rotation) ? 1 : 0
float SUM3_rotation = math.sum(src_rotation, 3)
int Missing_SUM3_rotation = na(SUM3_rotation) ? 1 : 0
float SMA7_rotation = ta.sma(src_rotation, 7)
int Missing_SMA7_rotation = na(SMA7_rotation) ? 1 : 0
float SUM7_rotation = math.sum(src_rotation, 7)
int Missing_SUM7_rotation = na(SUM7_rotation) ? 1 : 0
series float src_singleHuge = i == 0 ? large : small
float SMA1_singleHuge = ta.sma(src_singleHuge, 1)
int Missing_SMA1_singleHuge = na(SMA1_singleHuge) ? 1 : 0
float SUM1_singleHuge = math.sum(src_singleHuge, 1)
int Missing_SUM1_singleHuge = na(SUM1_singleHuge) ? 1 : 0
float SMA2_singleHuge = ta.sma(src_singleHuge, 2)
int Missing_SMA2_singleHuge = na(SMA2_singleHuge) ? 1 : 0
float SUM2_singleHuge = math.sum(src_singleHuge, 2)
int Missing_SUM2_singleHuge = na(SUM2_singleHuge) ? 1 : 0
float SMA3_singleHuge = ta.sma(src_singleHuge, 3)
int Missing_SMA3_singleHuge = na(SMA3_singleHuge) ? 1 : 0
float SUM3_singleHuge = math.sum(src_singleHuge, 3)
int Missing_SUM3_singleHuge = na(SUM3_singleHuge) ? 1 : 0
float SMA7_singleHuge = ta.sma(src_singleHuge, 7)
int Missing_SMA7_singleHuge = na(SMA7_singleHuge) ? 1 : 0
float SUM7_singleHuge = math.sum(src_singleHuge, 7)
int Missing_SUM7_singleHuge = na(SUM7_singleHuge) ? 1 : 0
series float src_recovery = i < 6 ? large : small
float SMA1_recovery = ta.sma(src_recovery, 1)
int Missing_SMA1_recovery = na(SMA1_recovery) ? 1 : 0
float SUM1_recovery = math.sum(src_recovery, 1)
int Missing_SUM1_recovery = na(SUM1_recovery) ? 1 : 0
float SMA2_recovery = ta.sma(src_recovery, 2)
int Missing_SMA2_recovery = na(SMA2_recovery) ? 1 : 0
float SUM2_recovery = math.sum(src_recovery, 2)
int Missing_SUM2_recovery = na(SUM2_recovery) ? 1 : 0
float SMA3_recovery = ta.sma(src_recovery, 3)
int Missing_SMA3_recovery = na(SMA3_recovery) ? 1 : 0
float SUM3_recovery = math.sum(src_recovery, 3)
int Missing_SUM3_recovery = na(SUM3_recovery) ? 1 : 0
float SMA7_recovery = ta.sma(src_recovery, 7)
int Missing_SMA7_recovery = na(SMA7_recovery) ? 1 : 0
float SUM7_recovery = math.sum(src_recovery, 7)
int Missing_SUM7_recovery = na(SUM7_recovery) ? 1 : 0
series float src_gapRecovery = i < 6 ? large : i < 12 ? na : small
float SMA1_gapRecovery = ta.sma(src_gapRecovery, 1)
int Missing_SMA1_gapRecovery = na(SMA1_gapRecovery) ? 1 : 0
float SUM1_gapRecovery = math.sum(src_gapRecovery, 1)
int Missing_SUM1_gapRecovery = na(SUM1_gapRecovery) ? 1 : 0
float SMA2_gapRecovery = ta.sma(src_gapRecovery, 2)
int Missing_SMA2_gapRecovery = na(SMA2_gapRecovery) ? 1 : 0
float SUM2_gapRecovery = math.sum(src_gapRecovery, 2)
int Missing_SUM2_gapRecovery = na(SUM2_gapRecovery) ? 1 : 0
float SMA3_gapRecovery = ta.sma(src_gapRecovery, 3)
int Missing_SMA3_gapRecovery = na(SMA3_gapRecovery) ? 1 : 0
float SUM3_gapRecovery = math.sum(src_gapRecovery, 3)
int Missing_SUM3_gapRecovery = na(SUM3_gapRecovery) ? 1 : 0
float SMA7_gapRecovery = ta.sma(src_gapRecovery, 7)
int Missing_SMA7_gapRecovery = na(SMA7_gapRecovery) ? 1 : 0
float SUM7_gapRecovery = math.sum(src_gapRecovery, 7)
int Missing_SUM7_gapRecovery = na(SUM7_gapRecovery) ? 1 : 0
if i < 32
    log.info("PYNE_OVERFLOW_MASK_HOLDOUT50|" + str.tostring(i) + "|" + str.tostring(src_keywordHalf, "0.00000000000000000") + "|" + str.tostring(Missing_SMA1_keywordHalf) + "|" + str.tostring(Missing_SUM1_keywordHalf) + "|" + str.tostring(Missing_SMA2_keywordHalf) + "|" + str.tostring(Missing_SUM2_keywordHalf) + "|" + str.tostring(Missing_SMA3_keywordHalf) + "|" + str.tostring(Missing_SUM3_keywordHalf) + "|" + str.tostring(Missing_SMA7_keywordHalf) + "|" + str.tostring(Missing_SUM7_keywordHalf) + "|" + str.tostring(src_branchHalf, "0.00000000000000000") + "|" + str.tostring(Missing_SMA1_branchHalf) + "|" + str.tostring(Missing_SUM1_branchHalf) + "|" + str.tostring(Missing_SMA2_branchHalf) + "|" + str.tostring(Missing_SUM2_branchHalf) + "|" + str.tostring(Missing_SMA3_branchHalf) + "|" + str.tostring(Missing_SUM3_branchHalf) + "|" + str.tostring(Missing_SMA7_branchHalf) + "|" + str.tostring(Missing_SUM7_branchHalf) + "|" + str.tostring(src_edgeFinite, "0.00000000000000000") + "|" + str.tostring(Missing_SMA1_edgeFinite) + "|" + str.tostring(Missing_SUM1_edgeFinite) + "|" + str.tostring(Missing_SMA2_edgeFinite) + "|" + str.tostring(Missing_SUM2_edgeFinite) + "|" + str.tostring(Missing_SMA3_edgeFinite) + "|" + str.tostring(Missing_SUM3_edgeFinite) + "|" + str.tostring(Missing_SMA7_edgeFinite) + "|" + str.tostring(Missing_SUM7_edgeFinite) + "|" + str.tostring(src_edgeCancellation, "0.00000000000000000") + "|" + str.tostring(Missing_SMA1_edgeCancellation) + "|" + str.tostring(Missing_SUM1_edgeCancellation) + "|" + str.tostring(Missing_SMA2_edgeCancellation) + "|" + str.tostring(Missing_SUM2_edgeCancellation) + "|" + str.tostring(Missing_SMA3_edgeCancellation) + "|" + str.tostring(Missing_SUM3_edgeCancellation) + "|" + str.tostring(Missing_SMA7_edgeCancellation) + "|" + str.tostring(Missing_SUM7_edgeCancellation) + "|" + str.tostring(src_preReadyRecover, "0.00000000000000000") + "|" + str.tostring(Missing_SMA1_preReadyRecover) + "|" + str.tostring(Missing_SUM1_preReadyRecover) + "|" + str.tostring(Missing_SMA2_preReadyRecover) + "|" + str.tostring(Missing_SUM2_preReadyRecover) + "|" + str.tostring(Missing_SMA3_preReadyRecover) + "|" + str.tostring(Missing_SUM3_preReadyRecover) + "|" + str.tostring(Missing_SMA7_preReadyRecover) + "|" + str.tostring(Missing_SUM7_preReadyRecover) + "|" + str.tostring(src_rotation, "0.00000000000000000") + "|" + str.tostring(Missing_SMA1_rotation) + "|" + str.tostring(Missing_SUM1_rotation) + "|" + str.tostring(Missing_SMA2_rotation) + "|" + str.tostring(Missing_SUM2_rotation) + "|" + str.tostring(Missing_SMA3_rotation) + "|" + str.tostring(Missing_SUM3_rotation) + "|" + str.tostring(Missing_SMA7_rotation) + "|" + str.tostring(Missing_SUM7_rotation) + "|" + str.tostring(src_singleHuge, "0.00000000000000000") + "|" + str.tostring(Missing_SMA1_singleHuge) + "|" + str.tostring(Missing_SUM1_singleHuge) + "|" + str.tostring(Missing_SMA2_singleHuge) + "|" + str.tostring(Missing_SUM2_singleHuge) + "|" + str.tostring(Missing_SMA3_singleHuge) + "|" + str.tostring(Missing_SUM3_singleHuge) + "|" + str.tostring(Missing_SMA7_singleHuge) + "|" + str.tostring(Missing_SUM7_singleHuge) + "|" + str.tostring(src_recovery, "0.00000000000000000") + "|" + str.tostring(Missing_SMA1_recovery) + "|" + str.tostring(Missing_SUM1_recovery) + "|" + str.tostring(Missing_SMA2_recovery) + "|" + str.tostring(Missing_SUM2_recovery) + "|" + str.tostring(Missing_SMA3_recovery) + "|" + str.tostring(Missing_SUM3_recovery) + "|" + str.tostring(Missing_SMA7_recovery) + "|" + str.tostring(Missing_SUM7_recovery) + "|" + str.tostring(src_gapRecovery, "0.00000000000000000") + "|" + str.tostring(Missing_SMA1_gapRecovery) + "|" + str.tostring(Missing_SUM1_gapRecovery) + "|" + str.tostring(Missing_SMA2_gapRecovery) + "|" + str.tostring(Missing_SUM2_gapRecovery) + "|" + str.tostring(Missing_SMA3_gapRecovery) + "|" + str.tostring(Missing_SUM3_gapRecovery) + "|" + str.tostring(Missing_SMA7_gapRecovery) + "|" + str.tostring(Missing_SUM7_gapRecovery) + ";")
plot(0., display=display.none)
