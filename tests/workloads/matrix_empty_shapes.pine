//@version=6
indicator("Pyne matrix empty shapes 20261002",overlay=false)
f(float v) => str.tostring(v,"#.##########")
shape(matrix<float> m) => "|"+f(matrix.rows(m))+"|"+f(matrix.columns(m))+"|"+f(matrix.elements_count(m))
var string rows = ""
if bar_index < 16
    int c = bar_index % 8
    int h = c == 1 or c == 4 ? 0 : c == 2 or c == 5 ? 3 : c == 3 or c == 6 ? 1 : c == 7 ? 2 : 0
    int w = c == 1 or c == 4 ? 3 : c == 3 or c == 6 ? 0 : c == 7 ? 2 : 0
    matrix<float> m = matrix.new<float>(h,w,2.0)
    matrix<float> alias = m
    matrix<float> cp = matrix.copy(m)
    matrix<float> tr = matrix.transpose(m)
    float rowSize = h > 0 ? array.size(matrix.row(m,0)) : float(na)
    float colSize = w > 0 ? array.size(matrix.col(m,w-1)) : float(na)
    rows += "PYNE_MATRIX_EMPTY_SHAPES|"+str.tostring(bar_index)+"|"+f(c)+shape(m)+shape(cp)+shape(tr)
    int rh = c == 0 ? 0 : c == 1 ? 3 : c == 2 ? 0 : c == 3 ? 0 : c == 4 ? 0 : c == 5 ? 3 : c == 6 ? 1 : 1
    int rw = c == 0 ? 0 : c == 1 ? 0 : c == 2 ? 3 : c == 3 ? 1 : c == 4 ? 3 : c == 5 ? 0 : c == 6 ? 0 : 4
    matrix<float> plus = matrix.sum(m,2.0)
    matrix<float> minus = matrix.diff(m,2.0)
    matrix<float> times = matrix.mult(m,2.0)
    matrix<float> product = matrix.mult(m,matrix.new<float>(w,2,1.0))
    float productFirst = h > 0 ? matrix.get(product,0,0) : float(na)
    string arithmetic = shape(plus)+shape(minus)+shape(times)+shape(product)+"|"+f(productFirst)+"|1"
    matrix.reshape(m,rh,rw)
    rows += shape(m)+shape(alias)+shape(cp)+arithmetic+"|"+f(rowSize)+"|"+f(colSize)+"|"+f(h > 0 ? 1 : 0)+"|"+f(w > 0 ? 1 : 0)+";"
    if bar_index % 8 == 7
        log.info(rows)
        rows := ""
plot(float(na),"Native empty shape probe")
