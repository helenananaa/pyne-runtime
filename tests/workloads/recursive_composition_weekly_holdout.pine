//@version=6
indicator("PYNE native recursive compositions 55", overlay=false)
fmt(float x) => na(x) ? "NA" : str.tostring(x, "0.00000000000000000")
atr1=ta.atr(1)
atr3=ta.atr(3)
atr7=ta.atr(7)
[p3,m3,a3]=ta.dmi(3,3)
[p7,m7,a7]=ta.dmi(7,7)
[p3x,m3x,a3x]=ta.dmi(3,7)
tr=ta.tr(true)
if bar_index < 64 and barstate.isconfirmed
    row="PYNE_RECURSIVE_COMPOSITION55|" + str.tostring(bar_index) + "|" + str.tostring(time / 1000)
    row += "|" + fmt(open) + "|" + fmt(high) + "|" + fmt(low) + "|" + fmt(close) + "|" + fmt(volume)
    row += "|" + fmt(tr) + "|" + fmt(atr1) + "|" + fmt(atr3) + "|" + fmt(atr7)
    row += "|" + fmt(p3) + "|" + fmt(m3) + "|" + fmt(a3)
    row += "|" + fmt(p7) + "|" + fmt(m7) + "|" + fmt(a7)
    row += "|" + fmt(p3x) + "|" + fmt(m3x) + "|" + fmt(a3x)
    log.info(row)
plot(atr3)
