//@version=6
indicator("Pyne percentile missing sort oracle 20260930",precision=10,max_bars_back=20)
int i=bar_index
float source=float((i*7)%13-4)
float holes=i==7 or i==12 or i==19 ? na : source
float leading=i<5 ? na : source
float empty=na
float v0=ta.percentile_nearest_rank(holes,4,0)
float v1=ta.percentile_nearest_rank(holes,4,25)
float v2=ta.percentile_nearest_rank(holes,4,50)
float v3=ta.percentile_nearest_rank(holes,4,75)
float v4=ta.percentile_nearest_rank(holes,4,100)
float v5=ta.percentile_linear_interpolation(holes,4,0)
float v6=ta.percentile_linear_interpolation(holes,4,25)
float v7=ta.percentile_linear_interpolation(holes,4,50)
float v8=ta.percentile_linear_interpolation(holes,4,75)
float v9=ta.percentile_linear_interpolation(holes,4,100)
float v10=ta.percentile_nearest_rank(leading,4,0)
float v11=ta.percentile_nearest_rank(leading,4,25)
float v12=ta.percentile_nearest_rank(leading,4,50)
float v13=ta.percentile_nearest_rank(leading,4,75)
float v14=ta.percentile_nearest_rank(leading,4,100)
float v15=ta.percentile_linear_interpolation(leading,4,0)
float v16=ta.percentile_linear_interpolation(leading,4,25)
float v17=ta.percentile_linear_interpolation(leading,4,50)
float v18=ta.percentile_linear_interpolation(leading,4,75)
float v19=ta.percentile_linear_interpolation(leading,4,100)
float v20=ta.percentile_nearest_rank(empty,4,0)
float v21=ta.percentile_nearest_rank(empty,4,25)
float v22=ta.percentile_nearest_rank(empty,4,50)
float v23=ta.percentile_nearest_rank(empty,4,75)
float v24=ta.percentile_nearest_rank(empty,4,100)
float v25=ta.percentile_linear_interpolation(empty,4,0)
float v26=ta.percentile_linear_interpolation(empty,4,25)
float v27=ta.percentile_linear_interpolation(empty,4,50)
float v28=ta.percentile_linear_interpolation(empty,4,75)
float v29=ta.percentile_linear_interpolation(empty,4,100)
float v30=ta.percentile_nearest_rank(holes,1,50)
float v31=ta.percentile_linear_interpolation(holes,1,50)
float v32=ta.percentile_nearest_rank(holes,2,50)
float v33=ta.percentile_linear_interpolation(holes,2,50)
array<float> newest=array.new_float()
array<float> oldest=array.new_float()
for j=0 to 3
    array.push(newest,holes[j])
    array.push(oldest,holes[3-j])
array.sort(newest,order.ascending)
array.sort(oldest,order.ascending)
f(float x)=>str.tostring(x,"#.##########")
var string rows=""
if i<32
    rows+="PYNE_PERCENTILE_SORT|"+str.tostring(i)+'|'+f(source)+'|'+f(holes)+'|'+f(leading)+'|'+f(empty)+'|'+f(v0)+'|'+f(v1)+'|'+f(v2)+'|'+f(v3)+'|'+f(v4)+'|'+f(v5)+'|'+f(v6)+'|'+f(v7)+'|'+f(v8)+'|'+f(v9)+'|'+f(v10)+'|'+f(v11)+'|'+f(v12)+'|'+f(v13)+'|'+f(v14)+'|'+f(v15)+'|'+f(v16)+'|'+f(v17)+'|'+f(v18)+'|'+f(v19)+'|'+f(v20)+'|'+f(v21)+'|'+f(v22)+'|'+f(v23)+'|'+f(v24)+'|'+f(v25)+'|'+f(v26)+'|'+f(v27)+'|'+f(v28)+'|'+f(v29)+'|'+f(v30)+'|'+f(v31)+'|'+f(v32)+'|'+f(v33)+'|'+f(array.get(newest,0))+'|'+f(array.get(newest,1))+'|'+f(array.get(newest,2))+'|'+f(array.get(newest,3))+'|'+f(array.get(oldest,0))+'|'+f(array.get(oldest,1))+'|'+f(array.get(oldest,2))+'|'+f(array.get(oldest,3))+";"
    if i%8==7
        log.info(rows)
        rows:=""
plot(v2,"Percentile sort oracle")
