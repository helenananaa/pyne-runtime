oles, "0.00000000000000000") + "|" + str.tostring(Scaled2_holes, "0.00000000000000000") + "|" + str.tostring(Native3_holes, "0.00000000000000000") + "|" + str.tostring(Sum3_holes, "0.00000000000000000") + "|" + str.tostring(Input_regime, "0.00000000000000000") + "|" + str.tostring(History1_regime, "0.00000000000000000") + "|" + str.tostring(History2_regime, "0.00000000000000000") + "|" + str.tostring(Array1_regime, "0.00000000000000000") + "|" + str.tostring(Array2_regime, "0.00000000000000000") + "|" + str.tostring(PairHistory_regime, "0.00000000000000000") + "|" + str.tostring(PairArray_regime, "0.00000000000000000") + "|" + str.tostring(Native2_regime, "0.00000000000000000") + "|" + str.tostring(Sum2_regime, "0.00000000000000000") + "|" + str.tostring(Scaled2_regime, "0.00000000000000000") + "|" + str.tostring(Native3_regime, "0.00000000000000000") + "|" + str.tostring(Sum3_regime, "0.00000000000000000") + ";")
