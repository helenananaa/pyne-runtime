var cache_holes = array.new_float()
array.push(cache_holes, src_holes)
if array.size(cache_holes) > 3
    array.shift(cache_holes)
float Input_holes = src_holes
float History1_holes = src_holes[1]
float History2_holes = src_holes[2]
float Array1_holes = array.size(cache_holes) > 1 ? array.get(cache_holes, array.size(cache_holes) - 2) : na
float Array2_holes = array.size(cache_holes) > 2 ? array.get(cache_holes, array.size(cache_holes) - 3) : na
float PairHistory_holes = (src_holes + src_holes[1]) / 2.
float PairArray_holes = (src_holes + (array.size(cache_holes) > 1 ? array.get(cache_holes, array.size(cache_holes) - 2) : na)) / 2.
float Native2_holes = ta.sma(src_holes, 2)
float Sum2_holes = math.sum(src_holes, 2)
float Scaled2_holes = ta.sma(src_holes / 2., 2) * 2.
float Native3_holes = ta.sma(src_holes, 3)
float Sum3_holes = math.sum(src_holes, 3)
float src_regime = i < 24 ? power : i < 48 ? base : i < 72 ? -power : base
var cache_regime = array.new_float()
array.push(cache_regime, src_regime)
if array.size(cache_regime) > 3
    array.shift(cache_regime)
float Input_regime = src_regime
float History1_regime = src_regime[1]
float History2_regime = src_regime[2]
float Array1_regime = array.size(cache_regime) > 1 ? array.get(cache_regime, array.size(cache_regime) - 2) : na
float Array2_regime = array.size(cache_regime) > 2 ? array.get(cache_regime, array.size(cache_regime) - 3) : na
float PairHistory_regime = (src_regime + src_regime[1]) / 2.
float PairArray_regime = (src_regime + (array.size(cache_regime) > 1 ? array.get(cache_regime, array.size(cache_regime) - 2) : na)) / 2.
float Native2_regime = ta.sma(src_regime, 2)
float Sum2_regime = math.sum(src_regime, 2)
