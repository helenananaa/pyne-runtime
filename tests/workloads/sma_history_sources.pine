//@version=6
indicator("Pyne SMA history sources round46", precision=10)
int i = bar_index
float base = float((i * 13) % 23 - 10) * 0.25
float power = math.pow(2., 80) + base * math.pow(2., 28)
float src_power = power
var cache_power = array.new_float()
array.push(cache_power, src_power)
if array.size(cache_power) > 3
    array.shift(cache_power)
float Input_power = src_power
float History1_power = src_power[1]
float History2_power = src_power[2]
float Array1_power = array.size(cache_power) > 1 ? array.get(cache_power, array.size(cache_power) - 2) : na
float Array2_power = array.size(cache_power) > 2 ? array.get(cache_power, array.size(cache_power) - 3) : na
float PairHistory_power = (src_power + src_power[1]) / 2.
float PairArray_power = (src_power + (array.size(cache_power) > 1 ? array.get(cache_power, array.size(cache_power) - 2) : na)) / 2.
float Native2_power = ta.sma(src_power, 2)
float Sum2_power = math.sum(src_power, 2)
float Scaled2_power = ta.sma(src_power / 2., 2) * 2.
float Native3_power = ta.sma(src_power, 3)
float Sum3_power = math.sum(src_power, 3)
