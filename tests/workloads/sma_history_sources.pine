float PairHistory_prefill = (src_prefill + src_prefill[1]) / 2.
float PairArray_prefill = (src_prefill + (array.size(cache_prefill) > 1 ? array.get(cache_prefill, array.size(cache_prefill) - 2) : na)) / 2.
